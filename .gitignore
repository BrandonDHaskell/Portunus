# ── Secrets & environment ──
.env*
# Re-include the committed, non-secret server profiles. .env and .env.prod stay
# ignored. (Patterns without a slash match at any depth, so server/.env.local
# and server/.env.ci are re-included.)
!.env.local
!.env.ci

# ── TLS material ──
certs/

# ── Archives / AI / editor scratch ──
*.tar.gz
.claude/

# ── Generic compiled artifacts (cross-cutting safety net) ──
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exe
*.out
*.d
*.gch
*.pch
# ── IDEs ──
# CLion/IDEA rebuild their project model from CMakePresets.json; nothing in
# .idea/ is needed to share the build. VS Code's shared config is in .vscode/.
.idea/
# Per-machine CMake presets (local compiler paths such as /opt/gcc).
CMakeUserPresets.json
# CLion/preset build trees for the firmware (idf.py keeps using build/).
cmake-build-*/
