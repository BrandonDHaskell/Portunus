{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Unit tests (default compiler)",
      "description": "Unit tier with whatever cc/c++ CMake finds on PATH.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-gcc",
      "inherits": "host",
      "displayName": "Unit tests (gcc on PATH)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "host-clang",
      "inherits": "host",
      "displayName": "Unit tests (clang on PATH)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "host-m32",
      "inherits": "host",
      "displayName": "Unit tests, ESP32-S3 data model (ILP32, 64-bit time_t, unsigned char)",
      "description": "Requires gcc-multilib and g++-multilib. Matches the Xtensa ESP32-S3 types that 64-bit hosts hide: 4-byte pointers, size_t and long; 8-byte time_t (glibc _TIME_BITS=64, as ESP-IDF 5); unsigned char. test_target_abi checks the preset still does.",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m32 -D_TIME_BITS=64 -D_FILE_OFFSET_BITS=64 -funsigned-char -DPORTUNUS_ESP32_DATA_MODEL=1",
        "CMAKE_CXX_FLAGS": "-m32 -D_TIME_BITS=64 -D_FILE_OFFSET_BITS=64 -funsigned-char -DPORTUNUS_ESP32_DATA_MODEL=1",
        "CMAKE_EXE_LINKER_FLAGS": "-m32"
      }
    },
    {
      "name": "host-asan",
      "inherits": "host",
      "displayName": "Unit tests with ASan + UBSan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "host-gcc", "configurePreset": "host-gcc" },
    { "name": "host-clang", "configurePreset": "host-clang" },
    { "name": "host-m32", "configurePreset": "host-m32" },
    { "name": "host-asan", "configurePreset": "host-asan" }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    },
    { "name": "host-gcc",   "inherits": "host", "configurePreset": "host-gcc" },
    { "name": "host-clang", "inherits": "host", "configurePreset": "host-clang" },
    { "name": "host-m32",   "inherits": "host", "configurePreset": "host-m32" },
    { "name": "host-asan",  "inherits": "host", "configurePreset": "host-asan" }
  ]
}
