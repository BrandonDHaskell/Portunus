# Component-tier Kconfig: the production menu, sourced rather than copied
# (decision D-T3), plus the test-only switches below. Test builds therefore
# run on production defaults; the sdkconfig.defaults* files override only
# what a variant must, and COMP-05 (test:firmware:component) rejects any
# other CONFIG_PORTUNUS_* override.
rsource "../../../main/Kconfig.projbuild"

menu "Portunus component tests"

    # Build test_heartbeat_main.cpp against the real heartbeat_service
    # (sdkconfig.defaults.hb, which also shortens the interval).
    config PORTUNUS_TEST_HEARTBEAT
        bool "Heartbeat service test app"
        default n

endmenu
