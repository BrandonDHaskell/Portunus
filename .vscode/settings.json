{
    // C/C++ code intelligence comes from clangd (same compile databases CLion
    // uses). Disable the Microsoft engine so the two don't fight.
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--query-driver=**/xtensa-esp*-elf-*,**/bin/gcc*,**/bin/g++*",
        "--header-insertion=never",
        "--background-index"
    ],

    // CMake Tools drives the plain-CMake host tests via CMakePresets.json.
    // Firmware builds go through Task or the ESP-IDF extension, which source
    // the IDF environment first.
    "cmake.sourceDirectory": "${workspaceFolder}/access_module/test/unit",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,

    "files.exclude": {
        "**/cmake-build-*": true
    }
}
